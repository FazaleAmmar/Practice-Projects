<!DOCTYPE html>
<html lang="en" class="h-full w-full bg-zinc-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="../styles/style.css" />
    <title>Edit</title>
  </head>
  <body class="h-full w-full bg-zinc-900 p-10">
    <div class="container h-full w-full bg-zinc-900 text-white relative">
      <h1 class="text-5xl font-bold text-center mb-4">All Cards</h1>
      <hr class="border-zinc-500 mb-10" />

      <form action="/edit/<%= user.id %>" method="post">
        <div class="name flex gap-10 ml-20 mt-10">
            <h3>Enter new name: </h3>
        <input
          type="text"
          placeholder="Name"
          name="name"
          value="<%= user.name %>"
          class="p-4 w-60 rounded-lg h-10 border border-zinc-500"
        />
        <input
          type="text"
          placeholder="New Name"
          name="newName"
          class="p-4 w-60 rounded-lg h-10 border border-zinc-500"
        />
      </div>

      <div class="email flex gap-10 ml-20 mt-10">
        <h3>Enter new email: </h3>
        <input
          type="text"
          placeholder="Email"
          name="email"
          value="<%= user.email %>"
          class="p-4 w-60 rounded-lg h-10 border border-zinc-500"
        />
        <input
          type="text"
          placeholder="New Email"
          name="newEmail"
          class="p-4 w-60 rounded-lg h-10 border border-zinc-500"
        />
      </div>

      <div class="image flex gap-10 ml-20 mt-10">
        <h3>Enter new image url: </h3>
        <input
          type="text"
          placeholder="image URL"
          name="image"
          class="p-4 w-60 rounded-lg h-10 border border-zinc-500"
          value="<%= user.image %>"
        />
        <input
          type="text"
          placeholder="new image URL"
          name="newImage"
          class="p-4 w-60 rounded-lg h-10 border border-zinc-500"
        />
      </div>

      <input type="submit" value="Update" class="h-10 w-30 rounded-lg bg-blue-600 mt-10" />
      <a class="h-10 w-30 rounded-lg py-3 px-7 bg-blue-600" href="/read">Cancel</a>
      </form>
    </div>
  </body>
</html>
