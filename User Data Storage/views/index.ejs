<!DOCTYPE html>
<html lang="en" class="h-full w-full bg-zinc-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="../styles/style.css" />
    <title>Home</title>
  </head>
  <body class="h-full w-full bg-zinc-900 p-10">
    <div class="container h-full w-full bg-zinc-900 text-white">
      <h1 class="text-5xl font-bold text-center mb-4">Create Card</h1>
      <hr class="border-zinc-500 mb-10">
      <form action="/create" method="post">
        <input type="text" placeholder="name" name="name" class="p-4 w-60 rounded-lg h-10 border border-zinc-500" />
        <input type="text" placeholder="email" name="email" class="p-4 w-60 rounded-lg h-10 border border-zinc-500" />
        <input type="text" placeholder="image URL" name="image" class="p-4 w-60 rounded-lg h-10 border border-zinc-500" />
        <input type="submit" value="Create" class="h-10 w-30 rounded-lg bg-blue-600" />
      </form>

      <a class="absolute bottom-10 right-10 bg-zinc-500 text-blue-500 p-2 rounded-md" href="/read">Go to Users</a>
    </div>
  </body>
</html>
