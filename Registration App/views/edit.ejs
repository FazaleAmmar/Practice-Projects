<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles/style.css" />
    <title>Edit Your Post</title>
  </head>
  <body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
      <div class="flex items-center justify-end w-full">
        <a
          class="inline-block mb-10 bg-red-500 rounded-md px-4 py-2 text-sm transition-all duration-300 ease-in hover:text-blue-500 hover:underline hover:bg-red-700"
          href="/logout"
          >Logout</a
        >
      </div>
      <h5 class="mb-5">Edit Your Posts</h5>
      <form action="/update/<%= post._id %>" method="post">
        <textarea
          class="block w-1/3 resize-none bg-transparent border-2 border-zinc-800 rounded-md p-3 outline-none"
          placeholder= "<%= post.content %>"
          name="content"
        ><%= post.content %></textarea>

        <textarea
          class="block w-1/3 resize-none bg-transparent border-2 border-zinc-800 rounded-md p-3 outline-none mt-10"
          placeholder= "Write something..."
          name="newcontent"
        ></textarea>
        <input
          class="block px-12 py-2 bg-blue-500 rounded-md mt-3"
          type="submit"
          value="Update"
        />
      </form>
    </div>
  </body>
</html>
