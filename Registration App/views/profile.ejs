<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="./styles/style.css" />
    <title>Profile of <%= user.username %></title>
  </head>
  <body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <div class="flex items-center justify-end w-full">
            <a class="inline-block mb-10 bg-red-500 rounded-md px-4 py-2 text-sm transition-all duration-300 ease-in hover:text-blue-500 hover:underline hover:bg-red-700" href="/logout">Logout</a>

        </div>
      <h3 class="text-3xl">Profile of <%= user.username %></h3>
      <h5 class="mb-5">You can create a new post.</h5>
      <form action="/post" method="post">
        <textarea
          class="block w-1/3 resize-none bg-transparent border-2 border-zinc-800 rounded-md p-3 outline-none"
          placehoder="What's on your mind?"
          name="content"
        ></textarea>
        <input class="block px-12 py-2 bg-blue-500 rounded-md mt-3" type="submit" value="Post">
      </form>

      <div class="posts mt-20">
        <h3 class="text-zinc-600 text-lg">Your posts.</h3>
        <div class="postContainer mt-5">
            <div class="post mb-4 w-1/3 p-4 rounded-md border border-zinc-700 bg-zinc-800">
                <h3 class="text-blue-500 mb-2">@<%= user.username %></h3>
                <p class="text-sm tracking-tight">Lorem ipsum dolor sit amet consectetur adipisicing elit.</p>

                <div class="btns flex gap-4">
                    <a class="text-blue-500" href="">Like</a>
                    <a class="text-zinc-600" href="">Edit</a>
                </div>
            </div>
        </div>
      </div>
    </div>
  </body>
</html>
