<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles/style.css" />
    <title>Profile of <%= user.username %></title>
  </head>
  <body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
      <div class="flex items-center justify-end w-full">
        <a
          class="inline-block mb-10 bg-red-500 rounded-md px-4 py-2 text-sm transition-all duration-300 ease-in hover:text-blue-500 hover:underline hover:bg-red-700"
          href="/logout"
          >Logout</a
        >
      </div>
      <div class="flex gap-2">
        <div class="w-10 h-10 rounded-4xl">
          <a href="/profile/upload">
            <img
              class="w-full h-full object-top object-cover rounded-4xl"
              src="/images/uploads/<%= user.profilepic %>"
              alt="ProfilePic"
            />
          </a>
        </div>
        <h3 class="text-3xl">Profile of <%= user.username %></h3>
      </div>
      <h5 class="my-5">You can create a new post.</h5>
      <form action="/post" method="post">
        <textarea
          class="block w-1/3 resize-none bg-transparent border-2 border-zinc-800 rounded-md p-3 outline-none"
          placeholder="What's on your mind?"
          name="content"
        ></textarea>
        <input
          class="block px-12 py-2 bg-blue-500 rounded-md mt-3"
          type="submit"
          value="Post"
        />
      </form>

      <div class="posts mt-20">
        <h3 class="text-zinc-600 text-lg">Your posts.</h3>
        <div class="postContainer mt-5 flex gap-3">
          <% user.posts.reverse().forEach(post => { %>
          <div
            class="post mb-4 w-1/3 p-4 rounded-md border border-zinc-700 bg-zinc-800"
          >
            <h3 class="text-blue-500 mb-2">@<%= user.username %></h3>
            <p class="text-sm tracking-tight"><%= post.content %></p>
            <div class="btns flex gap-4">
              <small><%= post.likes.length %> likes</small>
              <a class="text-blue-500" href="/like/<%= post._id %>">
                <%= (post.likes.includes(user._id) ? "Unlike": "Like") %>
              </a>
              <a class="text-zinc-600" href="/edit/<%= post._id %>">Edit</a>
              <a class="text-red-500" href="/delete/<%= post._id %>">Delete</a>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </div>
  </body>
</html>
