<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles/output.css" />
    <title>Notepad</title>
  </head>
  <body>
    <div class="main w-full min-h-screen bg-zinc-900">
      <div class="form p-10">
        <form action="/create" method="POST">
          <input
            class="block w-full rounded-md text-white outline-none px-5 py-2 bg-zinc-800"
            type="text"
            placeholder="Add a task"
            name="title"
          />
          <textarea
            class="block w-full rounded-md text-white outline-none px-5 mt-2 py-2 bg-zinc-800 resize-none"
            placeholder="Add a description"
            name="details"
          ></textarea>
          <input
            class="mt-2 text-white bg-gray-700 px-3 py-1 rounded hover:bg-blue-500 hover:cursor-pointer active:bg-blue-600"
            type="submit"
            value="Add"
          />
        </form>
      </div>

      <div class="tasks p-10 flex flex-wrap gap-4">
        <% if (files.length > 0) { %> <% files.forEach(element => { %>
        <div class="task min-w-72 px-3 py-4 bg-zinc-800 rounded-md text-white">
          <h1 class="text-white text-3xl tracking-tighter text-center">
            <%= element %>
          </h1>
          <div class="flex w-full justify-evenly items-center mt-3">
            <a class="text-blue-500 inline-block" href="/files/<%= element %>">
              Read More...
            </a>
            <a class="text-zinc-500" href="/edit/<%= element %>"
              >edit filename</a
            >
          </div>
        </div>
        <% }) %> <% } else { %>
        <h3 class="text-zinc-800 text-3xl tracking-tighter font-bold">
          No tasks
        </h3>
        <% } %>
      </div>
    </div>

    <script src="/javascript/script.js"></script>
  </body>
</html>
