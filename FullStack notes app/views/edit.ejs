<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles/output.css" />
    <title>Edit Data</title>
  </head>
  <body>
    <div class="main w-full min-h-screen bg-zinc-900 text-white p-10">
      <a href="/" class="text-blue-500 inline-block mb-10 decoration-none"
        >Go Back</a
      >

      <form action="/edit" method="POST">
        <input
          class="block w-full rounded-md text-white outline-none px-5 py-2 bg-zinc-800"
          type="text"
          placeholder="Previous Name"
          name="previous"
          value="<%= filename %>"
        />

        <input
          class="block w-full rounded-md text-white outline-none px-5 py-2 bg-zinc-800 mt-3"
          type="text"
          placeholder="New Name"
          name="new"
        />

        <input
          class="mt-2 text-white bg-gray-700 px-3 py-1 rounded hover:bg-blue-500 hover:cursor-pointer active:bg-blue-600"
          type="submit"
          value="Done"
        />
      </form>
    </div>
  </body>
</html>
